# Copy to .env and fill in. Never commit the real .env (already gitignored).

# Azure SQL Database (free tier) connection string, Prisma's own format:
#   sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=false
#
# HOST is the "Server name" shown in the Azure Portal (e.g.
# your-server.database.windows.net). PORT is always 1433 for Azure SQL.
# Used both by the Prisma CLI (prisma.config.ts) and, parsed, by the runtime
# driver adapter (lib/prisma.ts, see lib/db/connectionString.ts) — one value,
# not two that could drift out of sync.
DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=personalmoneymanager;user=youruser;password=yourpassword;encrypt=true;trustServerCertificate=false"

# Auth.js (auth.ts) — signs/encrypts the session JWT. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Only read by prisma/seed.ts (npx prisma db seed) to create/update your own
# login — there is no public signup page on purpose (personal-use app).
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="choose-a-real-password-locally"

# Web Push (security notifications — server/sendSecurityPush.ts, app/profilo/
# SecurityNotifications.tsx). Optional: without these, the app works exactly
# the same, just without push notifications. Generate a keypair once with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: link or https: URL identifying you, per the
# Web Push spec (some push services use it to contact you if something's wrong).
VAPID_PUBLIC_KEY="generated-public-key"
VAPID_PRIVATE_KEY="generated-private-key"
VAPID_SUBJECT="mailto:you@example.com"
